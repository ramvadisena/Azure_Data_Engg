{
	"name": "dataflow_Process_Reporting_data",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Fact_sales_Reporting",
						"type": "DatasetReference"
					},
					"name": "sourceSales"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "visa_cust_agg",
						"type": "DatasetReference"
					},
					"name": "sinkVisaData"
				}
			],
			"transformations": [
				{
					"name": "selectColumn"
				},
				{
					"name": "filterCustomer"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn"
				},
				{
					"name": "aggregateCusterPrice"
				}
			],
			"scriptLines": [
				"source(output(",
				"          transaction_id as integer,",
				"          transactional_date as date,",
				"          product_id as string,",
				"          customer_id as integer,",
				"          payment as string,",
				"          credit_card as integer,",
				"          loyalty_card as string,",
				"          cost as double,",
				"          quantity as integer,",
				"          price as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceSales",
				"sourceSales select(mapColumn(",
				"          transaction_id,",
				"          transactional_date,",
				"          product_id,",
				"          customer_id,",
				"          payment,",
				"          price",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumn",
				"selectColumn filter(customer_id != 12) ~> filterCustomer",
				"filterCustomer split(payment == 'visa',",
				"     payment == 'mastercard',",
				"     disjoint: false) ~> split1@(Visa, Mastercard, Amex)",
				"split1@Amex derive(payment = coalesce(payment,'N/A')) ~> derivedColumn",
				"split1@Visa aggregate(groupBy(customer_id),",
				"     price = max(price)) ~> aggregateCusterPrice",
				"aggregateCusterPrice sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkVisaData"
			]
		}
	}
}